# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/masterfund"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/masterfund"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Market Data API
YAHOO_FINANCE_API_KEY=""

# Android (Capacitor) - 배포된 서버 URL 또는 개발용 로컬 주소
# 실기기 개발: http://<내_IP>:3000 (예: http://192.168.1.100:3000)
# 에뮬레이터 개발: http://10.0.2.2:3000
# 프로덕션: https://your-domain.com
CAPACITOR_SERVER_URL="https://your-domain.com"
